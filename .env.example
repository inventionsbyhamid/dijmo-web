# dijmo-web configuration. The server reads the process environment only.
# For local development: cp .env.example .env, fill it in, then
#   set -a && . ./.env && set +a && cargo run -p dijmo-web
# .env is git-ignored. Never commit real keys. In production (Coolify), set
# these as environment variables on the application instead.

# Postgres 16. Locally: createdb dijmo_web_dev
DATABASE_URL=postgres://localhost/dijmo_web_dev

# The public address, no trailing slash. Links in emails and the Origin
# check on form posts use it.
PUBLIC_BASE_URL=http://localhost:8080

# 64+ random bytes, base64. Derives the keys that sign leave links and hash
# IP addresses. Generate: openssl rand -base64 64 | tr -d '\n'
# Changing it invalidates the leave links in emails already sent.
SECRET_KEY=

PORT=8080

# Email. `log` writes emails to the log (development). `resend` sends them
# through Resend. Unset: resend if RESEND_API_KEY is set, otherwise log.
EMAIL_PROVIDER=log
RESEND_API_KEY=
# A verified sender on your Resend domain. Replies go here, so use a real inbox.
EMAIL_FROM="Dijmo <hello@example.com>"

# Reverse proxies in front of the server: 0 locally, 1 behind Coolify's proxy,
# 2 behind Cloudflare (proxied) plus Coolify.
PROXY_HOPS=0

# Where assets/ lives (css/site.css and js/site.js are hashed at startup).
ASSETS_DIR=assets

# text (development) or json (production).
LOG_FORMAT=text
RUST_LOG=info,sqlx=warn

# Tests use this database (default: postgres://localhost/dijmo_web_test).
# TEST_DATABASE_URL=postgres://localhost/dijmo_web_test
